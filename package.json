{
  "name": "ha-world-heatmap-card",
  "version": "0.2.0",
  "description": "Reusable Home Assistant world heatmap custom card",
  "type": "module",
  "main": "dist/world-heatmap-card.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "mutate": "bash scripts/mutate.sh",
    "mutate:all": "stryker run"
  },
  "keywords": [
    "home-assistant",
    "custom-card",
    "lovelace",
    "heatmap",
    "world-map"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.1",
    "simpleheat": "^1.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "qs": "^6.16.1"
  }
}
